ng weed week weigh welcome west wet whale wheat wheel when where which while whirl whisper white who whole whose why width wife wild wilderness wildlife will win wind window wine wing wink winner winter wipe wisdom wise wish with withdraw witness wool word work world worry worth wrap wrist write wrong yard year yeast yellow yet yoga yogurt young youth zebra zero zone zoom').split(' ');

    function randomBelow(max) {
      const limit = Math.floor(4294967296 / max) * max;
      const buf = new Uint32Array(1);
      let x;
      do {
        crypto.getRandomValues(buf);
        x = buf[0];
      } while (x >= limit);
      return x % max;
    }

    function buildSet() {
      let set = '';
      if ($('c-lower').checked) set += 'abcdefghijklmnopqrstuvwxyz';
      if ($('c-upper').checked) set += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if ($('c-digits').checked) set += '0123456789';
      if ($('c-symbols').checked) set += '!@#$%^&*()-_=+[]{}<>?';
      if ($('c-plain').checked) set = set.replace(/[0O1lI|]/g, '');
      return set;
    }

    function generate() {
      const mode = $('mode').value;
      let pw;
      let bits;
      if (mode === 'phrase') {
        const count = 5;
        const words = [];
        for (let i = 0; i < count; i++) words.push(WORDS[randomBelow(WORDS.length)]);
        pw = words.join('-');
        bits = Math.round(count * Math.log2(WORDS.length));
      } else {
        const set = buildSet();
        if (!set) {
          $('password').textContent = 'Tick at least one kind of character.';
          $('strength').textContent = '';
          return;
        }
        const len = Math.min(64, Math.max(8, parseInt($('length').value, 10) || 16));
        pw = '';
        for (let i = 0; i < len; i++) pw += set[randomBelow(set.length)];
        bits = Math.round(len * Math.log2(set.length));
      }
      $('password').textContent = pw;
      const label = bits < 50 ? 'Light. Fine for low stakes accounts only.' : bits < 75 ? 'Decent. Good for most accounts.' : bits < 100 ? 'Strong. Well past guessing range.' : 'Very strong. Beyond any guessing attack going.';
      $('strength').textContent = 'About ' + bits + ' bits of entropy. ' + label;
      $('copied').textContent = '';
    }

    $('gen').addEventListener('click', generate);
    for (const id of ['length', 'c-lower', 'c-upper', 'c-digits', 'c-symbols', 'c-plain', 'mode']) {
      $(id).addEventListener('change', generate);
    }
    $('copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText($('password').textContent);
        $('copied').textContent = 'Copied.';
      } catch {
        $('copied').textContent = 'Copy did not work here, select the text and copy it by hand.';
      }
    });
    generate();
  </script>
